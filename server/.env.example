# Fly Expression Backend — Environment Config
# Copy to .env and fill in values

PORT=4000

# FlyBase — no API key required for public endpoints
# FLYBASE_BASE_URL=https://api.flybase.org/api/v1.0

# Ensembl — no API key required, but providing one increases rate limit
# ENSEMBL_KEY=

# NCBI E-utilities — optional, provides 10 req/s instead of 3
NCBI_EMAIL=your.email@example.com
# NCBI_API_KEY=

# SQLite cache path (default: ./cache/data/cache.db)
# CACHE_DIR=./cache/data
